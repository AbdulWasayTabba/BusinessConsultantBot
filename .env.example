# Copy to .env and fill in values. Never commit .env.

# --- LangSmith tracing (optional) ---
LANGCHAIN_API_KEY=
LANGCHAIN_TRACING_V2=
LANGCHAIN_PROJECT=

# --- Ollama (optional; defaults to http://localhost:11434) ---
OLLAMA_HOST=

# --- Session persistence (optional; empty = in-memory) ---
BIZGPT_CHECKPOINT_DB=

# API security: comma-separated keys for X-API-Key (empty = auth off), requests/min per client (0 = off)
BIZGPT_API_KEYS=
BIZGPT_RATE_LIMIT=30
